{
  "name": "silver-wolf-vi",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3005 --host=0.0.0.0 --strictPort",
    "share": "bash scripts/share-dev-server.sh",
    "share:url": "bash scripts/share-dev-server.sh --url",
    "share:stop": "bash scripts/share-dev-server.sh --stop",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:sourcemaps": "npm run build -- --sourcemap && sentry-cli sourcemaps inject ./dist && sentry-cli sourcemaps upload ./dist",
    "docs:generate": "node scripts/generate_docs.cjs",
    "docs:check": "node scripts/generate_docs.cjs --check",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx --fix",
    "test": "node scripts/test_cursor_engine.cjs && node scripts/test_physics_and_runtime.cjs && node scripts/test_integration_contracts.cjs && node scripts/test_responsive_layout.cjs && node scripts/test_state_slices.cjs && node scripts/test_zustand_adversarial_torture.cjs && node scripts/test_sentry_qa_integration.cjs && node scripts/test_coderabbit_config.cjs && node scripts/test_strict_torture.cjs && node scripts/test_negative_fault_injection.cjs && npm run docs:check",
    "test:strict": "npm run test",
    "test:vitest": "node ./node_modules/vitest/vitest.mjs run",
    "qa:check": "npm run typecheck && npm run test",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:audit:fast": "node scripts/ui-audit.mjs --fast",
    "perf:check": "node scripts/perf-check.mjs",
    "perf:check:fast": "node scripts/perf-check.mjs --fast",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "js-yaml@4": "^4.3.2",
    "postcss@8": "^8.5.18",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "protobufjs@<8": "^7.6.5",
    "protobufjs@>=8.0.0": "^8.6.5",
    "source-map-js": "^1.2.2",
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.5"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@wwtelescope/engine": "^7.41.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.41.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "satellite.js": "^5.0.0",
    "three": "^0.186.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^22.14.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "cesium": "^1.142.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "happy-dom": "^21.0.4",
    "playwright": "latest",
    "prettier": "^3.8.4",
    "puppeteer": "^25.2.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.1",
    "terser": "^5.49.2",
    "typescript": "~5.8.2",
    "vite": "^6.4.5",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^4.1.12",
    "@sentry/cli": "^3.8.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
